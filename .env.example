# Configuração do Notebook - Obrigatórios sempre
DATABRICKS_NOTEBOOK_PATH=/Repos/user/project/notebook
DATABRICKS_CLUSTER_ID=1234-567890-abcdefgh

# Autenticação:
# - Dev local: rode `databricks auth login --host https://seu-workspace.cloud.databricks.com`
#   O SDK detecta o token OAuth automaticamente. Nada a configurar aqui.
# - Databricks Apps: autenticação automática via service principal.

# Porta do servidor (Databricks Apps usa 8080, dev local pode usar outra)
# PORT=8080
