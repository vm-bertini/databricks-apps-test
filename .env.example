# Configuração do Notebook - Obrigatórios sempre
DATABRICKS_NOTEBOOK_PATH=/Repos/user/project/notebook
DATABRICKS_CLUSTER_ID=1234-567890-abcdefgh

# Autenticação para dev local (escolha UMA opção):
#
# Opção 1 - OAuth (recomendado, sem token manual):
#   Rode: databricks auth login --host https://seu-workspace.cloud.databricks.com
#   O SDK detecta o token OAuth automaticamente. Nada mais a configurar aqui.
#
# Opção 2 - PAT manual:
# DATABRICKS_HOST=https://seu-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=dapi_seu_token_aqui
#
# Em Databricks Apps: autenticação é automática via service principal.
# Não precisa de DATABRICKS_HOST nem DATABRICKS_TOKEN.

# Porta do servidor (Databricks Apps usa 8080, dev local pode usar outra)
# PORT=8080
